{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Bazaar Deal Room commercial fit assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opportunity_id",
    "snapshot_date",
    "decision",
    "decision_rationale",
    "requirements",
    "material_issues",
    "next_actions"
  ],
  "properties": {
    "opportunity_id": {
      "type": "string"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "decision": {
      "enum": [
        "PROCEED",
        "NEGOTIATE",
        "PAUSE",
        "REJECT"
      ]
    },
    "decision_rationale": {
      "type": "string",
      "minLength": 60
    },
    "requirements": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "status",
          "buyer_requirement",
          "seller_position",
          "analysis",
          "citations"
        ],
        "properties": {
          "requirement_id": {
            "$ref": "#/$defs/requirementId"
          },
          "status": {
            "enum": [
              "MEETS",
              "PARTIAL",
              "DOES_NOT_MEET",
              "UNVERIFIED"
            ]
          },
          "buyer_requirement": {
            "type": "string",
            "minLength": 20
          },
          "seller_position": {
            "type": "string",
            "minLength": 20
          },
          "analysis": {
            "type": "string",
            "minLength": 20
          },
          "citations": {
            "$ref": "#/$defs/citations"
          }
        }
      }
    },
    "material_issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "title",
          "severity",
          "requirement_ids",
          "finding",
          "required_resolution",
          "citations"
        ],
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/requirementId"
            }
          },
          "finding": {
            "type": "string"
          },
          "required_resolution": {
            "type": "string"
          },
          "citations": {
            "$ref": "#/$defs/citations"
          }
        }
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "priority",
          "owner",
          "requirement_ids",
          "action",
          "success_condition"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "IMMEDIATE",
              "BEFORE_SIGNATURE",
              "BEFORE_DEPLOYMENT"
            ]
          },
          "owner": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/requirementId"
            }
          },
          "action": {
            "type": "string"
          },
          "success_condition": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "requirementId": {
      "enum": [
        "gpu_quantity",
        "hardware_shape",
        "delivery_date",
        "location_residency",
        "network_fabric",
        "cooling_readiness",
        "sla",
        "all_in_price",
        "initial_term",
        "deposit_protection",
        "delay_termination"
      ]
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "locator"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^matter/"
          },
          "locator": {
            "type": "string"
          }
        }
      }
    }
  }
}
