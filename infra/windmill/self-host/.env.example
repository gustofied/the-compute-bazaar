# Copy this file to /opt/windmill/.env on the VPC host and replace values.
# Keep the real .env off git and chmod it to 600.

POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@db/windmill?sslmode=disable
SUPERADMIN_SECRET=replace-with-a-random-virtual-superadmin-token

# Tested image identities. Update these intentionally after checking release notes and running
# the health checks in ../README.md; do not track floating main/latest tags on the live host.
WM_IMAGE=ghcr.io/windmill-labs/windmill@sha256:b21a570fd5245b294a578fad19828bb8da00e4d5f6b46e039889d7564a07b89c
WM_WORKER_IMAGE=compute-bazaar-windmill-worker:YYYY-MM-DD-description
CADDY_IMAGE=ghcr.io/windmill-labs/caddy-l4@sha256:70d73dddd7a6cbbc47161322731783c6014416fcf2ff12eb21e65c985024556e
POSTGRES_IMAGE=postgres@sha256:081f1bc7bd5e143dbb6e487b710bbc27712cdcfaced4c071b8e47349aa1b4171

# The compose template binds the UI to 127.0.0.1:8081 on the EC2 host.
# Reach it from your laptop with:
# ssh -i .secrets/compute-bazaar-automq-runtime.pem -L 8081:127.0.0.1:8081 ec2-user@RUNTIME_HOST
BASE_URL=:80
ADDRESS=0.0.0.0

AWS_REGION=eu-west-3
AWS_DEFAULT_REGION=eu-west-3
SILENCE_HEALTH_LOGS=true
